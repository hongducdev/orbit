<Page
    x:Class="Orbit.OptimizePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="32">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="560">
            <FontIcon Glyph="&#xE9E9;" Style="{StaticResource OrbitPlaceholderIconStyle}" Foreground="{StaticResource OrbitMercuryBrush}" />
            <TextBlock Text="Mercury — Optimize" Style="{StaticResource OrbitTitleTextStyle}" HorizontalAlignment="Center" FontSize="28" />
            <TextBlock Text="Bounded maintenance tasks — flush DNS, rebuild icon cache, Delivery Optimization, disk health."
                       TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"
                       Style="{StaticResource OrbitBodySecondaryStyle}" />
            <Border Style="{StaticResource MoleCardStyle}" Margin="0,12,0,0">
                <StackPanel Spacing="8">
                    <TextBlock Text="Coming in Phase 6" FontWeight="SemiBold" />
                    <TextBlock Text="One UAC prompt per session, dry-run preview, skipped-with-reason for every task."
                               TextWrapping="Wrap" Opacity="0.7" />
                    <HyperlinkButton Content="Mole reference — mo optimize" NavigateUri="https://mole.fit" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
