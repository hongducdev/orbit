<Page
    x:Class="Orbit.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer Padding="32">
        <StackPanel Spacing="24" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource OrbitTitleTextStyle}" FontSize="28" />
            <TextBlock Text="Preferences persist via ApplicationData LocalSettings and survive restarts."
                       Style="{StaticResource OrbitBodySecondaryStyle}" TextWrapping="Wrap" />

            <!-- Appearance -->
            <Border Style="{StaticResource MoleCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Appearance" FontWeight="SemiBold" FontSize="16" />
                    <ComboBox x:Name="ThemeCombo" Header="Theme" SelectedIndex="0" SelectionChanged="ThemeCombo_SelectionChanged" MinWidth="200">
                        <ComboBoxItem Content="System default" Tag="default" />
                        <ComboBoxItem Content="Light" Tag="light" />
                        <ComboBoxItem Content="Dark" Tag="dark" />
                    </ComboBox>
                    <TextBlock Text="Applies on next navigation. Mica backdrop falls back to Acrylic on Win10 17763."
                               Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Planet animation -->
            <Border Style="{StaticResource MoleCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Planet intro" FontWeight="SemiBold" FontSize="16" />
                    <ToggleSwitch x:Name="PlanetAnimationToggle" Header="Planet landing animation"
                                  Toggled="PlanetAnimationToggle_Toggled" />
                    <TextBlock Text="Mole's planet landing intro — disable for reduced motion."
                               Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Delete mode -->
            <Border Style="{StaticResource MoleCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Safety" FontWeight="SemiBold" FontSize="16" />
                    <ComboBox x:Name="DeleteModeCombo" Header="Delete mode" SelectedIndex="0" SelectionChanged="DeleteModeCombo_SelectionChanged" MinWidth="260">
                        <ComboBoxItem Content="Move to Recycle Bin (recommended)" Tag="recycle" />
                        <ComboBoxItem Content="Permanent delete" Tag="permanent" />
                    </ComboBox>
                    <TextBlock Text="Default is Recycle Bin (FOF_ALLOWUNDO). Permanent delete requires explicit selection."
                               Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- System access -->
            <Border Style="{StaticResource MoleCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="System access" FontWeight="SemiBold" FontSize="16" />
                    <TextBlock Text="Full Disk Access is not required for Phase 2. Scans and privileged operations will request a single UAC prompt per session when needed."
                               TextWrapping="Wrap" Opacity="0.7" />
                    <HyperlinkButton Content="Open File System privacy settings" NavigateUri="ms-settings:privacy-filesystem" />
                    <InfoBar Title="Tip" Message="If scans miss protected folders, run Orbit elevated or grant filesystem access — never run the whole app elevated by default." IsOpen="True" IsClosable="False" Severity="Informational" />
                </StackPanel>
            </Border>

            <!-- About -->
            <Border Style="{StaticResource MoleCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="About Orbit" FontWeight="SemiBold" FontSize="16" />
                    <TextBlock Text="Mole-inspired Windows system utility. Port of mole.fit mental model to WinUI 3 / C++/WinRT."
                               TextWrapping="Wrap" Opacity="0.7" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <HyperlinkButton Content="mole.fit" NavigateUri="https://mole.fit" />
                        <HyperlinkButton Content="github.com/tw93/Mole" NavigateUri="https://github.com/tw93/Mole" />
                    </StackPanel>
                    <TextBlock x:Name="VersionText" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
