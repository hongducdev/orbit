<Page
    x:Class="Orbit.CleanPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="32">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="560">
            <FontIcon Glyph="&#xE774;" Style="{StaticResource OrbitPlaceholderIconStyle}" Foreground="{StaticResource OrbitEarthBrush}" AutomationProperties.Name="Clean icon" />
            <TextBlock Text="Earth — Clean" Style="{StaticResource OrbitTitleTextStyle}" HorizontalAlignment="Center" FontSize="28" />
            <TextBlock Text="Review-first cache cleaner. Hardlink-aware sizing, movable to Recycle Bin, conservative whitelist."
                       TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"
                       Style="{StaticResource OrbitBodySecondaryStyle}" />
            <Border Style="{StaticResource MoleCardStyle}" Margin="0,12,0,0">
                <StackPanel Spacing="8">
                    <TextBlock Text="Coming in Phase 3" FontWeight="SemiBold" />
                    <TextBlock Text="Categories: User Temp, System Temp, Windows Update, Delivery Optimization, Thumbnail cache, Shader cache, Browser temp, Dev caches, WER, Recycle Bin."
                               TextWrapping="Wrap" Opacity="0.7" />
                    <HyperlinkButton Content="Mole reference — mo clean" NavigateUri="https://mole.fit" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
