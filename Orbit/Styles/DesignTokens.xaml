<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Orbit Design Tokens — Mole-inspired, Windows-native -->

    <!-- Primary -->
    <Color x:Key="OrbitPrimaryColor">#0078D4</Color>
    <SolidColorBrush x:Key="OrbitPrimaryBrush" Color="{StaticResource OrbitPrimaryColor}" />

    <!-- Planet accents -->
    <Color x:Key="OrbitEarthColor">#0F6C5C</Color>
    <Color x:Key="OrbitJupiterColor">#D18800</Color>
    <Color x:Key="OrbitMarsColor">#C0392B</Color>
    <Color x:Key="OrbitMercuryColor">#5D6D7E</Color>
    <Color x:Key="OrbitSunColor">#F39C12</Color>

    <SolidColorBrush x:Key="OrbitEarthBrush" Color="{StaticResource OrbitEarthColor}" />
    <SolidColorBrush x:Key="OrbitJupiterBrush" Color="{StaticResource OrbitJupiterColor}" />
    <SolidColorBrush x:Key="OrbitMarsBrush" Color="{StaticResource OrbitMarsColor}" />
    <SolidColorBrush x:Key="OrbitMercuryBrush" Color="{StaticResource OrbitMercuryColor}" />
    <SolidColorBrush x:Key="OrbitSunBrush" Color="{StaticResource OrbitSunColor}" />

    <!-- Lightened variants for dark theme backgrounds -->
    <Color x:Key="OrbitEarthTintColor">#1A8C7A</Color>
    <Color x:Key="OrbitJupiterTintColor">#E8A020</Color>
    <Color x:Key="OrbitMarsTintColor">#E05040</Color>
    <Color x:Key="OrbitMercuryTintColor">#7A8D9E</Color>
    <Color x:Key="OrbitSunTintColor">#F5B041</Color>

    <!-- Health-score thresholds -->
    <Color x:Key="OrbitHealthGoodColor">#0F7B0F</Color>
    <Color x:Key="OrbitHealthWarnColor">#D18800</Color>
    <Color x:Key="OrbitHealthCriticalColor">#C0392B</Color>
    <SolidColorBrush x:Key="OrbitHealthGoodBrush" Color="{StaticResource OrbitHealthGoodColor}" />
    <SolidColorBrush x:Key="OrbitHealthWarnBrush" Color="{StaticResource OrbitHealthWarnColor}" />
    <SolidColorBrush x:Key="OrbitHealthCriticalBrush" Color="{StaticResource OrbitHealthCriticalColor}" />

    <!-- Clean safety tiers -->
    <SolidColorBrush x:Key="OrbitTierSafeBrush" Color="{StaticResource OrbitHealthGoodColor}" />
    <SolidColorBrush x:Key="OrbitTierReviewBrush" Color="{StaticResource OrbitHealthWarnColor}" />
    <SolidColorBrush x:Key="OrbitTierRiskyBrush" Color="{StaticResource OrbitHealthCriticalColor}" />

    <!-- Spacing scale -->
    <x:Double x:Key="OrbitSpaceXS">4</x:Double>
    <x:Double x:Key="OrbitSpaceS">8</x:Double>
    <x:Double x:Key="OrbitSpaceM">12</x:Double>
    <x:Double x:Key="OrbitSpaceL">16</x:Double>
    <x:Double x:Key="OrbitSpaceXL">24</x:Double>
    <x:Double x:Key="OrbitSpace2XL">32</x:Double>

    <!-- Corner radius -->
    <CornerRadius x:Key="OrbitCardCornerRadius">12,12,12,12</CornerRadius>
    <CornerRadius x:Key="OrbitControlCornerRadius">6,6,6,6</CornerRadius>

    <!-- NavigationView item height -->
    <x:Double x:Key="OrbitNavItemHeight">48</x:Double>

    <!-- MoleCard style — rounded, layered -->
    <Style x:Key="MoleCardStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource OrbitCardCornerRadius}" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- Planet glyph sizes -->
    <x:Double x:Key="OrbitPlanetGlyphSize">20</x:Double>
    <x:Double x:Key="OrbitPlanetGlyphSizeCompact">16</x:Double>

    <!-- Title typography -->
    <Style x:Key="OrbitTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="OrbitSubtitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
        <Setter Property="Opacity" Value="0.7" />
    </Style>
    <Style x:Key="OrbitBodySecondaryStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="Opacity" Value="0.6" />
    </Style>

    <!-- Placeholder page icon -->
    <Style x:Key="OrbitPlaceholderIconStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="48" />
        <Setter Property="Opacity" Value="0.9" />
    </Style>

</ResourceDictionary>
