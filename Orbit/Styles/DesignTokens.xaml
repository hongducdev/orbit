<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Orbit Design Tokens — Mole-inspired, Windows-native -->

    <!-- Primary -->
    <Color x:Key="OrbitPrimaryColor">#0078D4</Color>
    <SolidColorBrush x:Key="OrbitPrimaryBrush" Color="{StaticResource OrbitPrimaryColor}" />

    <!-- Planet accents -->
    <Color x:Key="OrbitEarthColor">#0F6C5C</Color>
    <Color x:Key="OrbitJupiterColor">#D18800</Color>
    <Color x:Key="OrbitMarsColor">#C0392B</Color>
    <Color x:Key="OrbitMercuryColor">#5D6D7E</Color>
    <Color x:Key="OrbitSunColor">#F39C12</Color>

    <SolidColorBrush x:Key="OrbitEarthBrush" Color="{StaticResource OrbitEarthColor}" />
    <SolidColorBrush x:Key="OrbitJupiterBrush" Color="{StaticResource OrbitJupiterColor}" />
    <SolidColorBrush x:Key="OrbitMarsBrush" Color="{StaticResource OrbitMarsColor}" />
    <SolidColorBrush x:Key="OrbitMercuryBrush" Color="{StaticResource OrbitMercuryColor}" />
    <SolidColorBrush x:Key="OrbitSunBrush" Color="{StaticResource OrbitSunColor}" />

    <!-- Lightened variants for dark theme backgrounds -->
    <Color x:Key="OrbitEarthTintColor">#1A8C7A</Color>
    <Color x:Key="OrbitJupiterTintColor">#E8A020</Color>
    <Color x:Key="OrbitMarsTintColor">#E05040</Color>
    <Color x:Key="OrbitMercuryTintColor">#7A8D9E</Color>
    <Color x:Key="OrbitSunTintColor">#F5B041</Color>

    <!-- Health-score thresholds -->
    <Color x:Key="OrbitHealthGoodColor">#0F7B0F</Color>
    <Color x:Key="OrbitHealthWarnColor">#D18800</Color>
    <Color x:Key="OrbitHealthCriticalColor">#C0392B</Color>
    <SolidColorBrush x:Key="OrbitHealthGoodBrush" Color="{StaticResource OrbitHealthGoodColor}" />
    <SolidColorBrush x:Key="OrbitHealthWarnBrush" Color="{StaticResource OrbitHealthWarnColor}" />
    <SolidColorBrush x:Key="OrbitHealthCriticalBrush" Color="{StaticResource OrbitHealthCriticalColor}" />

    <!-- Clean safety tiers -->
    <SolidColorBrush x:Key="OrbitTierSafeBrush" Color="{StaticResource OrbitHealthGoodColor}" />
    <SolidColorBrush x:Key="OrbitTierReviewBrush" Color="{StaticResource OrbitHealthWarnColor}" />
    <SolidColorBrush x:Key="OrbitTierRiskyBrush" Color="{StaticResource OrbitHealthCriticalColor}" />

    <!-- Spacing scale -->
    <x:Double x:Key="OrbitSpaceXS">4</x:Double>
    <x:Double x:Key="OrbitSpaceS">8</x:Double>
    <x:Double x:Key="OrbitSpaceM">12</x:Double>
    <x:Double x:Key="OrbitSpaceL">16</x:Double>
    <x:Double x:Key="OrbitSpaceXL">24</x:Double>
    <x:Double x:Key="OrbitSpace2XL">32</x:Double>

    <!-- Corner radius -->
    <CornerRadius x:Key="OrbitCardCornerRadius">12,12,12,12</CornerRadius>
    <CornerRadius x:Key="OrbitControlCornerRadius">6,6,6,6</CornerRadius>

    <!-- NavigationView item height -->
    <x:Double x:Key="OrbitNavItemHeight">48</x:Double>

    <!-- MoleCard style — rounded, layered -->
    <Style x:Key="MoleCardStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource OrbitCardCornerRadius}" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- Clean category list -->
    <SolidColorBrush x:Key="OrbitTierSafeChipBackgroundBrush" Color="#331A8C7A" />
    <SolidColorBrush x:Key="OrbitTierReviewChipBackgroundBrush" Color="#33E8A020" />
    <SolidColorBrush x:Key="OrbitTierRiskyChipBackgroundBrush" Color="#33E05040" />
    <SolidColorBrush x:Key="OrbitJupiterChipBackgroundBrush" Color="#33E8A020" />

    <Style x:Key="CleanCategoryListItemStyle" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FocusVisualMargin" Value="0" />
    </Style>

    <!-- Suppress the square ListView hover so the inner rounded card can paint its own. -->
    <Style x:Key="AnalyzeLocationListItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource CleanCategoryListItemStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <ListViewItemPresenter
                        ContentMargin="0"
                        Padding="{TemplateBinding Padding}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                        PointerOverBackground="Transparent"
                        PressedBackground="Transparent"
                        SelectedBackground="Transparent"
                        SelectedPointerOverBackground="Transparent"
                        SelectedPressedBackground="Transparent"
                        SelectionCheckMarkVisualEnabled="False" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CleanCategoryExpanderStyle" TargetType="Expander">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="CornerRadius" Value="{StaticResource OrbitCardCornerRadius}" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,4,8,8" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="CleanCategoryIconHostStyle" TargetType="Border">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="CornerRadius" Value="10,10,10,10" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="CleanTierChipStyle" TargetType="Border">
        <Setter Property="Padding" Value="8,3,8,3" />
        <Setter Property="CornerRadius" Value="11,11,11,11" />
        <Setter Property="MinWidth" Value="84" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="AnalyzeOptionComboStyle" TargetType="ComboBox">
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="Height" Value="32" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="10,4,8,4" />
    </Style>
    <Style x:Key="AnalyzeOptionLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Opacity" Value="0.6" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="CleanImpactSizeStyle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <!-- Planet glyph sizes -->
    <x:Double x:Key="OrbitPlanetGlyphSize">20</x:Double>
    <x:Double x:Key="OrbitPlanetGlyphSizeCompact">16</x:Double>

    <!-- Title typography -->
    <Style x:Key="OrbitTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="OrbitSubtitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
        <Setter Property="Opacity" Value="0.7" />
    </Style>
    <Style x:Key="OrbitBodySecondaryStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="Opacity" Value="0.6" />
    </Style>

    <!-- Treemap category fills -->
    <SolidColorBrush x:Key="OrbitTreemapMediaBrush" Color="#C4A574" />
    <SolidColorBrush x:Key="OrbitTreemapDocsBrush" Color="#6E7F6B" />
    <SolidColorBrush x:Key="OrbitTreemapSystemBrush" Color="#8B6E7A" />
    <SolidColorBrush x:Key="OrbitTreemapLargeBrush" Color="#C4785A" />
    <SolidColorBrush x:Key="OrbitTreemapOtherBrush" Color="#5D6D7E" />
    <SolidColorBrush x:Key="OrbitTreemapCloudBrush" Color="#3A4A5A" />
    <SolidColorBrush x:Key="OrbitTreemapTanBrush" Color="#C4A574" />
    <SolidColorBrush x:Key="OrbitTreemapOchreBrush" Color="#D4A054" />
    <SolidColorBrush x:Key="OrbitTreemapPurpleBrush" Color="#8B6E7A" />
    <SolidColorBrush x:Key="OrbitTreemapTerraBrush" Color="#C4785A" />
    <SolidColorBrush x:Key="OrbitTreemapSageBrush" Color="#6E7F6B" />
    <SolidColorBrush x:Key="OrbitTreemapSlateBrush" Color="#5D6D7E" />

    <Style x:Key="AnalyzeTreemapTileStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="4,4,4,4" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style x:Key="OrbitPlaceholderIconStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="48" />
        <Setter Property="Opacity" Value="0.9" />
    </Style>

</ResourceDictionary>
